# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True

# Databáze (produkce – Postgres; lokálně se použije SQLite)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Produkční managed Postgres často vyžaduje SSL:
# DATABASE_SSL_REQUIRE=True

# Hosty této instance (žádné baked-in klubové domény v kódu)
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# EXTRA_ALLOWED_HOSTS=klub.example.com,www.klub.example.com
# EXTRA_CSRF_TRUSTED_ORIGINS=https://klub.example.com,https://www.klub.example.com

# HTTPS za proxy (produkce, DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# Branding / landing
# PRODUCT_NAME=TenisSystém
# CONTACT_EMAIL=info@tenissystem.cz
# Multi-school adresář (JSON) – u single-tenant nechte prázdné; landing vezme SystemNastaveni
# TENNIS_SCHOOLS=

# Bootstrap (non-interactive create-admin / Docker entrypoint)
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_NAZEV=
# BOOTSTRAP_EMAIL=
# BOOTSTRAP_ADMIN_USER=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# E-mail (produkce)
# EMAIL_FORCE_SMTP=True
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_USE_TLS=False
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=TenisSystém <noreply@example.com>
# SERVER_EMAIL=noreply@example.com
# EMAIL_SUBJECT_PREFIX=[TenisSystém]

# Observability (volitelné)
# INSTANCE_NAME=klub-xy
# SENTRY_DSN=https://…@….ingest.sentry.io/…
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Rate-limit loginu (django-axes)
# AXES_ENABLED=True
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_TIME=1

# Média v produkci (S3 / Cloudflare R2 / MinIO) — doporučeno při DEBUG=False
# USE_S3=1
# AWS_STORAGE_BUCKET_NAME=tenissystem-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://….r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=
# AWS_QUERYSTRING_AUTH=0

# Předplatné za software (Stripe) — 1 Customer ↔ 1 instance
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_PRICE_ID=price_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_REQUIRE_SUBSCRIPTION=1
# BILLING_ACTIVE=1
# STRIPE_CUSTOMER_ID=cus_…   # volitelný seed; Checkout/webhook uloží do DB
# Online platby hráčů (Stripe Connect Express)
# STRIPE_PLAYER_CURRENCY=czk
# STRIPE_CONNECT_COUNTRY=CZ
# STRIPE_CONNECT_TEST_BYPASS=1   # jen sk_test_: přeskočí Connect KYC (Checkout na platformu)
# Veřejná URL instance (odkazy v e-mailech / Stripe return)
# PUBLIC_BASE_URL=https://klub.example.com
