# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True

# Databáze (produkce – Postgres; lokálně se použije SQLite)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Produkční managed Postgres často vyžaduje SSL:
# DATABASE_SSL_REQUIRE=True

# Hosty této instance
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# EXTRA_ALLOWED_HOSTS=klub.example.com,www.klub.example.com
# EXTRA_CSRF_TRUSTED_ORIGINS=https://klub.example.com,https://www.klub.example.com

# Branding / landing
# PRODUCT_NAME=TenisSystém
# CONTACT_EMAIL=info@tenissystem.cz
# Multi-school adresář (JSON) – u single-tenant nechte prázdné; landing vezme SystemNastaveni
# TENNIS_SCHOOLS=

# Bootstrap (non-interactive create-admin)
# BOOTSTRAP_ADMIN_PASSWORD=

# E-mail (produkce)
# EMAIL_FORCE_SMTP=True
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=TenisSystém <noreply@example.com>

# --- Příklad produkční domény (nahraď svojí) ---
# EXTRA_ALLOWED_HOSTS=klub.example.com,www.klub.example.com
# EXTRA_CSRF_TRUSTED_ORIGINS=https://klub.example.com,https://www.klub.example.com
